{
  // Node で動く側（テストと、ルートの設定ファイル vite/vitest/drizzle）の型検査。
  // Node の型はここだけに効かせる。アプリ本体（src・portal/src）は tsconfig.json が Node の型なしで見る。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "vite/client", "node"]
  },
  "include": ["*.ts", "tests", "scripts/contract_adapter"]
}
