{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "study-app",
  // 個人アカウント（2026-09-15 に社用アカウントから移した）。別アカウントのログインでは wrangler が明示的に止まる
  "account_id": "6408e560f74d14fa46bd410ef28bf52b",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-01-15",
  "compatibility_flags": ["nodejs_compat"],
  // API と静的アセットを同じ Worker から配信する。Pages との2デプロイをやめて1つに。
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "study-app-db",
      "database_id": "bcf31b51-d926-4aa9-9aaa-213868de2de3",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "study-app",
    "EXAM": "ip"
  },
  // JWT_SECRET は wrangler secret put で設定する。vars には置かない。

  // 試験ごとに別の D1・別の Pages プロジェクトへ出す。コードは同じもの。
  // named environment は vars と d1_databases を継承しないので、各 env に書き切る。
  // 使い方: scripts/deploy-pages.sh ip|ap
  "env": {
    "ip": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "study-app-db",
          "database_id": "bcf31b51-d926-4aa9-9aaa-213868de2de3",
          "migrations_dir": "migrations"
        }
      ],
      "vars": { "APP_NAME": "study-app", "EXAM": "ip", "SSO_PORTAL_URL": "https://manabiba-5oz.pages.dev" },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application"
      }
    },
    "ap": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "study-app-ap-db",
                  "database_id": "0b515505-9177-43db-a65b-e742d08b6e11",
          "migrations_dir": "migrations"
        }
      ],
      "vars": { "APP_NAME": "study-app-ap", "EXAM": "ap", "SSO_PORTAL_URL": "https://manabiba-5oz.pages.dev" },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application"
      }
    },
    // 3 つ目: IT コンサル就活ロードマップ（試作。要件定義書 §13）。資格ではないがコードは同じ。
    "itc": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "study-app-itc-db",
          "database_id": "3ce45c40-2a3a-48ac-b540-08f56c233cc1",
          "migrations_dir": "migrations"
        }
      ],
      "vars": { "APP_NAME": "study-app-itc", "EXAM": "itc", "SSO_PORTAL_URL": "https://manabiba-5oz.pages.dev" },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application"
      }
    },
    "mkt": {
      "d1_databases": [
        { "binding": "DB", "database_name": "study-app-mkt-db", "database_id": "91f01b79-ff9e-4b1f-a270-fc0bed98ff91", "migrations_dir": "migrations" }
      ],
      "vars": { "APP_NAME": "study-app-mkt", "EXAM": "mkt", "SSO_PORTAL_URL": "https://manabiba-5oz.pages.dev" },
      "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application" }
    },
    "msg": {
      "d1_databases": [
        { "binding": "DB", "database_name": "study-app-msg-db", "database_id": "6723c3ad-9d86-4cb0-9c84-f22ccb01504b", "migrations_dir": "migrations" }
      ],
      "vars": { "APP_NAME": "study-app-msg", "EXAM": "msg", "SSO_PORTAL_URL": "https://manabiba-5oz.pages.dev" },
      "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application" }
    },
    "ecl": {
      "d1_databases": [
        { "binding": "DB", "database_name": "study-app-ecl-db", "database_id": "cb509df6-8e38-4ebd-8c97-d2d485d3bb34", "migrations_dir": "migrations" }
      ],
      "vars": { "APP_NAME": "study-app-ecl", "EXAM": "ecl", "SSO_PORTAL_URL": "https://manabiba-5oz.pages.dev" },
      "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application" }
    },
    "eca": {
      "d1_databases": [
        { "binding": "DB", "database_name": "study-app-eca-db", "database_id": "2cfbb7a7-a4b8-4769-9775-89296ee92a77", "migrations_dir": "migrations" }
      ],
      "vars": { "APP_NAME": "study-app-eca", "EXAM": "eca", "SSO_PORTAL_URL": "https://manabiba-5oz.pages.dev" },
      "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application" }
    }
  }
}
