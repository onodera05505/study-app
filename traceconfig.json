{
  "_comment": "原本 harness（tsay-dev/harness v4.1.0）の traceconfig。tools/trace-check・spec-lint・gate-hook が読む。docs-migrate Phase 1 で置いた（2026-09-30）。source はアプリ（src・portal/src）と運用スクリプト、tests は vitest の単体（client/server/portal）。tests.system は UC ごとのシナリオ＝jsdom の tests/scenario と、wrangler dev を要する Python の検査（scripts）。commands.system は未宣言（毎停止で回すには遅い。pre-push が回す）。layering・contract は無し（層構造とエラーコードの単一の出所が無い）。schema は drizzle の schema とまなびばの DDL。commands.test は vitest だけ（stop-gate が spec-lint と trace-check を自分で回す）。",
  "id_patterns": {
    "goal": "\\bGOAL-\\d{2}\\b",
    "uc": "\\bUC-\\d{3}\\b",
    "req": "\\bREQ-\\d{3}\\b",
    "br": "\\bBR-\\d{3}\\b",
    "nfr": "\\bNFR-\\d{3}\\b",
    "adr": "\\bADR-\\d{4}\\b"
  },
  "covers_pattern": "@covers\\s+(REQ-\\d{3})(?:#([\\w-]+))?",
  "scenario_pattern": "@scenario\\s+(UC-\\d{3})",
  "implements_pattern": "@implements\\s+((?:REQ|BR|UC)-\\d{3}(?:\\s*[,/]\\s*(?:REQ|BR|UC)-\\d{3})*)",
  "docs": {
    "goals_dir": "docs/goals",
    "goals_backlog": "docs/goals-backlog.md",
    "rules_dir": "docs/rules",
    "nfr_dir": "docs/nfr",
    "adr_dir": "docs/adr",
    "verification_global": "docs/verification/GLOBAL.md",
    "verification_deferred": "docs/verification/DEFERRED.md",
    "shared": "docs/_shared/components.yaml",
    "actors": "docs/02-actors.md"
  },
  "commands": {
    "typecheck": "npm run typecheck",
    "test": "npx vitest run"
  },
  "source": {
    "dirs": [
      "src",
      "portal/src",
      "scripts",
      "portal/static"
    ],
    "extensions": [
      ".ts",
      ".tsx",
      ".py",
      ".sh",
      ".js",
      ".mjs"
    ]
  },
  "tests": {
    "dirs": [
      "tests/client",
      "tests/server",
      "tests/portal"
    ],
    "extensions": [
      ".ts",
      ".tsx"
    ],
    "test_pattern": "^\\s*(?:it|test)\\(\\s*[\"'`](.+?)[\"'`]",
    "covers_placement": "before",
    "system": {
      "dirs": [
        "tests/scenario",
        "scripts"
      ],
      "extensions": [
        ".tsx",
        ".py"
      ]
    }
  },
  "schema": {
    "files": [
      "src/server/db/schema.ts",
      "portal/migrations/0001_init.sql"
    ]
  },
  "baseline_file": ".trace-baseline.json"
}
