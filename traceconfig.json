{
  "_comment": "trace_check（scripts/trace/trace_check.mjs、正本は ~/.claude/brain/tools/trace/）の設定。spec_document は仕様書と規範的な節、usecases は UC の書類、spec は要件。source は公開単位と @implements、tests は test_pattern と @verifies を見る。1 要件を実装する単位は max_units_per_req まで。除外は scripts/trace_ignore に理由つきで（本人の許可なく足さない）。commands.test は Stop フックが回す。",
  "spec_document": {
    "file": "docs/要件定義書_draft.md",
    "sections": [
      "3.1",
      "4",
      "5.1",
      "5.2",
      "5.3",
      "5.4",
      "5.5",
      "5.6",
      "9",
      "10",
      "13.5",
      "13.6",
      "15",
      "16.1",
      "16.2",
      "16.3",
      "16.4",
      "17"
    ]
  },
  "usecases": "docs/usecases",
  "spec": "docs/spec.yaml",
  "ignore": "scripts/trace_ignore",
  "max_units_per_req": 1,
  "source": [
    {
      "dirs": [
        "src/server",
        "src/shared",
        "src/client",
        "portal/src"
      ],
      "extensions": [
        ".ts",
        ".tsx"
      ],
      "exclude": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.d.ts",
        "portal/.worker-build/**",
        "portal/dist/**"
      ],
      "tag_lookback": 6,
      "public_patterns": [
        {
          "pattern": "^export\\s+(?:default\\s+)?(?:async\\s+)?function\\s+(\\w+)",
          "kind": "function"
        },
        {
          "pattern": "^export\\s+(?:default\\s+)?class\\s+(\\w+)",
          "kind": "class"
        },
        {
          "pattern": "^export\\s+const\\s+(\\w+)\\s*(?::[^=]+)?=\\s*(?:async\\s*)?(?:\\([^)]*\\)|\\w+)\\s*(?::[^=]+)?=>",
          "kind": "function"
        },
        {
          "pattern": "^\\s*\\w+\\.(?:get|post|put|delete|patch)\\(\\s*['\"]([^'\"]*)['\"]",
          "kind": "route"
        }
      ]
    },
    {
      "_comment": "seed の門と版の印（version.json）は不変条件・仕様の実装でもある。公開単位の検査はしない（Python・sh は第 2 段）",
      "files": [
        "scripts/check_seed.py",
        "scripts/build_seed.py",
        "scripts/deploy-pages.sh"
      ],
      "extensions": [
        ".py",
        ".sh"
      ],
      "public_patterns": []
    }
  ],
  "tests": [
    {
      "dirs": [
        "tests"
      ],
      "extensions": [
        ".ts",
        ".tsx"
      ],
      "test_pattern": "^\\s*(?:it|test)\\(\\s*['\"`](.+?)['\"`]",
      "tag_lookback": 6
    },
    {
      "files": [
        "scripts/check_api.py",
        "scripts/check_source.py",
        "scripts/check_seed.py",
        "scripts/verify_seed_remote.py",
        "scripts/check_sso_prod.sh",
        "scripts/check_render.tsx",
        "scripts/check_portal_api.py"
      ],
      "extensions": [
        ".py",
        ".sh",
        ".tsx"
      ],
      "test_pattern": "^def (check_\\w+|verify_\\w+)\\(",
      "tag_lookback": 6
    }
  ],
  "commands": {
    "test": "npm test"
  }
}
