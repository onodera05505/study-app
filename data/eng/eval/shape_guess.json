 "cues": [
  {
   "cue": "言い切り・極端な語を避ける",
   "how": "「だけ」「直接」「そのまま」「一度に」「最初から」「要らない」「関係なく」「十分」「〜すれば」「〜ない」などの断定・限定・否定の語の数を数え、多い選択肢ほど減点（重み -1.0/語）。誤答が「〜だけ」「直す所は無い」の形で作られていることが多い"
  },
  {
   "cue": "ほかの選択肢との共通度（多数派）",
   "how": "選択肢どうしの文字 2-gram の Jaccard 平均が高い物を加点（重み 1.5）。誤答は正解の一部を入れ替えて作られるため、正解は他の 3 つの部品を最も多く共有しやすい"
  },
  {
   "cue": "双子の選択肢",
   "how": "2 つだけ極端に似た組（類似度 0.35 超、2 番目の組と 0.08 以上差）があれば、正解はその組の中と見て候補を 2 つに絞り、残りの手がかりで選んだ（58 問で発動）"
  },
  {
   "cue": "問題文の語が入っている",
   "how": "問題文と共有する 2-gram の割合を加点（重み 1.5）。事例問題で状況の語（「ストレージにまだ空きがある」等）に触れる選択肢を優先"
  },
  {
   "cue": "釣り合い・手順の言い回し",
   "how": "「加えて」「確かめ」「疑う」「ながら」「分け」「場合」「〜ても」など、条件つき・併用・確認の語を加点（重み 0.6/語）"
  },
  {
   "cue": "長さ",
   "how": "平均より長い選択肢をわずかに加点（重み小）。この問題集は 4 択の長さがそろえてあり、ほとんど効かなかった"
  }
 ]
